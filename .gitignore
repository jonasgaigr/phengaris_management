.Rproj.user
.Rhistory
.RData
.Ruserdata

# Regenerated by the cascade (Rscript run_all.R); not tracked.
Data/Processed/
Data/Temp/
Outputs/

# The VMB and KVES kraj archives (several GB) and their per-kraj extracts,
# kept by R/tools/download_habitat_layers.R, and the two layers it builds
# from them (about 330 MB); not tracked. RETRIEVED.yml, which records the
# archives and their md5, is.
Data/Cache/
Data/Input/habitats/*.gpkg

# Output snapshots used to diff code changes (R/tools/compare_snapshots.R).
Data/Snapshots/

# The landscape rasters built from the cache by
# R/tools/build_landscape_layers.R (about 50 MB); not tracked. BUILT.yml is.
Data/Input/landscape/*.tif
